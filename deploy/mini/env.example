# Template for /usr/local/etc/rota/. One file per reader; each root:rota 0640.
# KEY=value per line, no quotes, no export; values are read literally.
# Copy each block into the file named in its header and fill in the values.

#### env: read by the api and web runtimes
API_URL=https://api.rota.monster
APP_URL=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
SUPER_ADMIN_WORKOS_USER_IDS=
ANALYTICS_SHARED_SECRET=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=

#### api.env: api runtime and db:prepare only
SECRET_KEY_BASE=
CORS_ORIGINS=
HOUSEROTA_API_DATABASE_PASSWORD=
WORKOS_JWT_ISSUER=
DEFAULT_PHONE_COUNTRY=GB
ANTHROPIC_API_KEY=
SENTRY_DSN=
SPEND_GBP_PER_USD=
FIXED_MONTHLY_COST_GBP=
SMS_ESTIMATED_SEGMENT_COST_GBP=
RAILS_MAX_THREADS=
JOB_CONCURRENCY=
RAILS_LOG_LEVEL=
# --- Mode: exactly one of the two blocks below. ---
# PARALLEL (dark), while Railway is production (BLO-2005). No jobs run, nothing is
# texted: Twilio's test credentials (Console, Account, API keys, Test credentials)
# accept a send and deliver nothing. rota-run.sh refuses to start the api if this
# block is half-applied.
ROTA_MODE=parallel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006
# SOLID_QUEUE_IN_PUMA and SIGNUP_ALERT_PHONE stay absent.
# LIVE, from cutover (BLO-2006): delete the block above, then
# SOLID_QUEUE_IN_PUMA=1
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SIGNUP_ALERT_PHONE=

#### web.env: web runtime only
WORKOS_REDIRECT_URI=
WORKOS_COOKIE_PASSWORD=
# Skips the trip out through Cloudflare; overrides env's API_URL for web only.
API_URL=http://127.0.0.1:3000

#### build.env: next build only; anything else in it is dropped
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

#### deploy.env: deploy.sh only
HEALTHCHECKS_DEPLOY_URL=

#### backup.env: backup.sh only
HEALTHCHECKS_BACKUP_URL=
HOUSEROTA_API_DATABASE_PASSWORD=
BACKUP_AGE_RECIPIENT=
BACKUP_R2_DEST=r2:rota-backups/primary
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
