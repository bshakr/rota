<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>monster.rota.postgres</string>
	<key>UserName</key>
	<string>rota</string>
	<key>GroupName</key>
	<string>rota</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/opt/postgresql@16/bin/postgres</string>
		<string>-D</string>
		<string>/opt/rota/pgdata</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/rota</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>/opt/rota/log/postgres.log</string>
	<key>StandardErrorPath</key>
	<string>/opt/rota/log/postgres.log</string>
</dict>
</plist>
