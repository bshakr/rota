# Copy to .env at the repo root and fill in. Both apps read this one file:
#
#   cp .env.example .env
#
# apps/api points dotenv at the repo root (see apps/api/config/application.rb).
# apps/web must do the same in next.config.ts.
#
# .env is gitignored. Never commit real credentials.

# --- Core ---------------------------------------------------------------------------

# DATABASE_URL is for PRODUCTION ONLY. Leave both of these commented out locally.
#
# Development and test get their database names from apps/api/config/database.yml, and
# config/application.rb deletes these two variables outside production so they cannot do
# any harm. Here is the harm they used to do:
#
# A DATABASE_URL names ONE database, and Rails applies it to whichever environment is
# booting. This .env is loaded in test as well as development. So setting it to the
# development database — as this file used to, uncommented — pointed `bundle exec rspec`
# at the DEVELOPMENT database, where Rails' maintain_test_schema! promptly tried to purge
# it. Only an internal Rails guard stopped the wipe, and the failure was swallowed, so
# the suite still printed green while connected to the wrong database.
#
# If you need to reach a non-default Postgres locally, use libpq's PGHOST / PGUSER /
# PGPASSWORD / PGPORT instead. They set the connection, never the database name.
#
# DATABASE_URL=postgres://user:pass@host/houserota_api_production
# QUEUE_DATABASE_URL=postgres://user:pass@host/houserota_api_production_queue

# Public URL of the Next.js app. Baked into every magic link we text out, so a wrong
# value here sends people to a dead host and the text cannot be recalled. Also the
# default CORS origin the API accepts. In production it is https://rota.monster.
APP_URL=http://localhost:3001

# Where the Next.js app finds the Rails API.
API_URL=http://localhost:3000

# Extra browser origins allowed to call the API, comma-separated. Only needed when
# APP_URL isn't the whole story — preview deploys, say. Defaults to APP_URL.
# CORS_ORIGINS=http://localhost:3001,https://preview.rota.monster

# Production only. This app has no config/credentials.yml.enc — every secret is an env
# var, so there is one place to look. Development and test generate a local secret
# automatically and don't need this set.
# Generate with: cd apps/api && bin/rails secret
# SECRET_KEY_BASE=

# --- WorkOS AuthKit (admin login, lives in Next.js) ---------------------------------

# Rails never calls WorkOS; it verifies the JWT against the JWKS endpoint. Only the
# client id is needed there, to resolve the right JWKS URL.
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me

# Optional, and only Rails reads it. The `iss` claim Rails will accept on an access token.
# Unset outside production, it accepts either issuer WorkOS documents — the bare
# https://api.workos.com/ and the client-scoped https://api.workos.com/user_management/<client id>
# — on the WorkOS host and no other. In PRODUCTION the bare form is refused (it names no client),
# so you must either let tokens carry the client-scoped issuer or pin the exact string here — which
# is also what a custom auth domain needs. Getting it wrong refuses every token, so decode a real
# token first (bin/rails 'workos:inspect_token[<jwt>]') and set what yours actually says.
# WORKOS_JWT_ISSUER=https://api.workos.com/user_management/client_replace_me

# AuthKit callback, must match the redirect URI registered in the WorkOS dashboard.
WORKOS_REDIRECT_URI=http://localhost:3001/callback

# Encrypts the AuthKit session cookie. At least 32 characters.
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=replace_me_with_at_least_32_characters

# --- Super admin (operator console) --------------------------------------------------

# Comma-separated WorkOS user ids allowed into the operator console at /super-admin and
# /api/super_admin/*, which reads across every house in the database. Yours starts with
# "user_" and is visible at /api/me as workos_user_id, in the WorkOS dashboard under
# Users, or with: cd apps/api && bin/rails 'workos:inspect_token[<jwt>]'
#
# Unset or empty means NOBODY, in every environment including development: the whole area
# answers 404 and the nav link does not appear. That is deliberate — granting it is a
# deploy, never a click, and nothing in the app can write this list. Rails resolves it once
# at boot (apps/api/config/initializers/super_admin.rb); it must never reach the browser.
# SUPER_ADMIN_WORKOS_USER_IDS=user_01EXAMPLE,user_01ANOTHER

# --- Spend (what the operator console prices against) --------------------------------

# Both of these are read by SuperAdmin::Spend (apps/api/app/queries/super_admin/spend.rb),
# which answers /api/super_admin/spend. Both are optional and neither can break the page:
# a value that is not a number is logged and ignored rather than reported as a cost.
# Everything here is USD — Twilio and Anthropic both bill in it and nothing converts.

# Hosting, WorkOS, the Twilio number rental: the monthly bill that does not vary with how
# much any one house is used. The spend page divides it across the houses that were active
# in the range, prorated by the months in that range, and shows it in its OWN column so it
# can never be mistaken for a charge a house actually incurred.
#
# Unset means no allocated line is shown at all, which is deliberate — a zero would read as
# "hosting is free" rather than "nobody has told us the figure".
# FIXED_MONTHLY_COST_USD=120

# What one SMS segment is assumed to cost while Twilio has not settled a price for it.
# Twilio bills per destination network and only reports the real charge minutes after
# delivery, so the newest rows on any spend page are always estimates. They are shown as a
# separate figure with their own count and never blended into the settled one.
#
# Defaults to 0.0079, Twilio's US list price per outbound segment. Raise it if most texts go
# somewhere dearer. It matters less the longer BackfillSmsPricesJob has been running, but it never
# stops mattering: a text that aged out of Twilio's roughly thirteen-month retention before anyone
# asked its price can never be settled and carries this rate for good. The spend page counts those
# rows apart, as texts_unpriceable, so an estimate that will never resolve is never mistaken for
# one that is merely waiting its turn.
# SMS_ESTIMATED_SEGMENT_COST_USD=0.0079

# --- Twilio (SMS) -------------------------------------------------------------------

# Development does not send texts. It runs a null adapter that writes the rendered body
# to the log and invents a SID, so a `bin/jobs` running against a database full of real
# phone numbers cannot text anybody — whatever the credentials below say. The variables
# are not even read.
#
# Set SMS_ADAPTER=twilio once you want to exercise the wire. Do that with a Twilio *test*
# credential and the magic number +15005550006: real API responses, real error codes,
# nothing delivered. Production always uses the real adapter and refuses to boot with
# SMS_ADAPTER=null, which would mean texting nobody while every dashboard stayed green.
#
# The test suite runs the real adapter on purpose — WebMock is what blocks the network.
# See apps/api/spec/sms/no_live_sms_spec.rb.
# SMS_ADAPTER=twilio

TWILIO_ACCOUNT_SID=ACreplace_me
TWILIO_AUTH_TOKEN=replace_me
# The number reminders are sent from, in E.164. Twilio's magic test number by default.
TWILIO_FROM_NUMBER=+15005550006

# These same credentials are what the spend collectors read with. A text's price is not in the
# create response — Twilio settles it minutes after delivery — so BackfillSmsPricesJob fetches it
# nightly and `bin/rails twilio:backfill_prices` recovers the history, both by GET, never a send.
# Under SMS_ADAPTER=null there is no account to ask and every row comes back unpriced.

# --- Anthropic (house calendar away inference) ---------------------------------------

# The hourly calendar sync asks Claude Haiku 4.5 which event titles mean a housemate is
# away (BLO-1667). Event titles, their dates, and housemates' names as entered in the app
# are the only things that leave the server. Production refuses to boot without this key,
# the same way it refuses to boot without Twilio credentials.
#
# Development and test boot fine without one: the classifier raises, the sync stores the
# events unsorted, and the next run tries again. Use a key from a dedicated Anthropic
# workspace so the spend shows up on its own line.
ANTHROPIC_API_KEY=

# --- Analytics ------------------------------------------------------------------------

# The homepage funnel: ten named events, stored in this app's own database. There is no
# third party, no SDK, no script in the page and no analytics cookie. See
# docs/runbooks/analytics-funnel.md.
#
# ONE variable, and it is optional. It is the shared secret the web app presents to the API
# at POST /internal/analytics/events, which is how the four events the browser and the
# /callback route own get from Next into Rails. The six events that belong to a house are
# written by Rails in-process and need nothing here.
#
# Unset means: the Next handler forwards nothing, and the Rails endpoint answers 404 to
# everybody, so an unconfigured deploy has no open write path into the events table rather
# than an unauthenticated one. That is the state in CI, in the specs, and on a developer's
# machine. Nothing here is required to boot.
#
# Generate one with: openssl rand -hex 32
# It must be the SAME value in both apps; they read this one file.
ANALYTICS_SHARED_SECRET=
||||||| parent of 5526dd6 (Report errors to Sentry from the Rails API and the Next.js web app)

# --- Sentry (error reporting, both apps) --------------------------------------------

# Nothing here is needed to run locally. With no DSN both SDKs are disabled: development
# never sends, the test suites never touch the network, and `bin/ci` / `npm run ci` pass
# with this whole section commented out. Only `production` and `preview` ever send, so a
# DSN pasted in below still sends nothing from a development boot.
#
# The plan, including what may never reach Sentry, is docs/sentry-error-logging.md.

# apps/api, runtime. Production REFUSES TO BOOT without it, on purpose: an app that runs
# unreported is one whose first symptom of a broken sweep is a house that quietly stopped
# being texted. Leave it unset here and the Rails SDK is simply off.
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0

# apps/web, build AND runtime. The first of the two NEXT_PUBLIC_ variables in this repo,
# and the exception needs saying out loud because next.config.ts deliberately exports
# nothing through Next's `env` key so that no secret is ever inlined into the browser
# bundle. A DSN is not a secret: it is a public, write-only address, rate-limited by
# Sentry, and the browser reaches it through our own /monitoring route rather than
# sentry.io. Next inlines it at build time, so on Railway it must be set as a BUILD
# variable as well as a runtime one, or the browser half reports nothing.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0

# apps/web, BUILD ONLY, and the second and last NEXT_PUBLIC_ variable in this repo. The
# browser cannot read SENTRY_ENVIRONMENT below, so without this every deploy calls itself
# `production` (that is what NODE_ENV is in any Railway build) and a preview deploy's
# browser events land in the production project's alert rules. It names an environment,
# not a credential, which is why it is allowed to be inlined. Next inlines it at build
# time, so setting it as a runtime variable alone changes nothing.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=preview

# Both apps, runtime. Which environment an event belongs to. Defaults to the Rails env and
# NODE_ENV. Set it to `preview` on a preview deploy so preview noise stays out of the
# production alert rules; anything other than `production` or `preview` sends nothing. The
# browser half reads NEXT_PUBLIC_SENTRY_ENVIRONMENT above instead, so set both on a
# preview deploy.
# SENTRY_ENVIRONMENT=preview

# Both apps, build and runtime. Which deploy an event came from, and the name the web
# source maps are uploaded under. Defaults to RAILWAY_GIT_COMMIT_SHA, which Railway sets
# for us, so this is an override and not a requirement. If it disagrees between build and
# runtime, browser stack traces arrive unsymbolicated.
# SENTRY_RELEASE=

# apps/web, BUILD ONLY. Uploads source maps, so a browser stack trace reads as TypeScript
# rather than minified chunks. Scopes: project:releases, project:write, org:read. It is a
# write credential, so it is a Railway build variable and never a runtime one. Absent in
# CI and locally, where the upload is skipped and the build must still pass.
# SENTRY_AUTH_TOKEN=

# apps/web, build only. Which Sentry organisation and project those maps belong to.
# SENTRY_ORG=
# SENTRY_PROJECT=

# Both apps, runtime. Performance tracing, which is off until the error side is trusted.
# Sampled 0 to 1; every trace costs quota, so 0.1 is the number to start with when the day
# comes.
# SENTRY_TRACES_SAMPLE_RATE=0

# apps/web, runtime. Unlocks the temporary /debug/sentry-smoke page, which throws on
# purpose so one signed-in visit proves the server half, the browser half and the tunnel
# all work. Anything other than 1 and the route answers 404. Set it, visit it, unset it.
# SENTRY_SMOKE=1
